{
  "id" : "com.github.captainerd.piano_watterfall",
  "runtime" : "org.freedesktop.Platform",
  "runtime-version" : "25.08",
  "runtime-commit" : "96b4841ce2b8c1acc3ede1d19a5cc802d633d21d56e95682bd7fd1b32fb0b506",
  "sdk" : "org.freedesktop.Sdk",
  "sdk-commit" : "31507d1bfc6a5bd5835aeb3cb07e7b7aeea69332502ecce1c671cea96ed3ebc2",
  "build-options" : {
    "append-path" : "/usr/lib/sdk/rust-stable/bin"
  },
  "command" : "piano-watterfall",
  "modules" : [
    {
      "name" : "piano_watterfall",
      "buildsystem" : "simple",
      "sources" : [
        {
          "path" : "../",
          "type" : "dir"
        }
      ],
      "build-commands" : [
        "cargo --offline build --release",
        "mkdir -p /app/share/piano_watterfall/",
        "cp -ap ./default.sf2 /app/share/piano_watterfall/default.sf2",
        "find target/release -maxdepth 1 -type f -executable -exec install -Dm755 {} -t /app/bin/ \\;",
        "install -Dm644 ./flatpak/com.github.captainerd.piano_watterfall.desktop -t /app/share/applications/",
        "install -Dm644 ./flatpak/com.github.captainerd.piano_watterfall.png -t /app/share/icons/hicolor/256x256/apps/"
      ]
    }
  ],
  "sdk-extensions" : [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "finish-args" : [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri"
  ],
  "source-date-epoch" : 1785908608
}